{
  "npmCommand": [
    "bun"
  ],
  "warnings": {
    "anthropicExtraUsage": false
  },
  "lastChangelogVersion": "1.5.2",
  "theme": "catppuccin-frappe",
  "defaultThinkingLevel": "high",
  "quietStartup": true,
  "defaultTools": [
    "+grep",
    "+find"
  ],
  "hideThinkingBlock": false,
  "packages": [
    "npm:pi-btw",
    "npm:pi-session-auto-rename",
    "~/go/src/github.com/DataDog/datadog-pi-packages/packages/dd-ai-gateway"
  ],
  "extensions": [
    "-extensions/phone-notify.ts",
    "-extensions/read-aloud/index.ts",
    "-extensions/workflows/index.ts",
    "-extensions/trajectory/index.ts",
    "-extensions/ui-performance.ts"
  ],
  "skills": [
    "~/dd/claude-marketplace/serverless/skills",
    "~/dd/experimental/users/ava.silver/ssi/skills/"
  ],
  "defaultProvider": "anthropic",
  "defaultModel": "claude-opus-5-5",
  "enabledModels": [
    "anthropic/claude-opus-5-5",
    "anthropic/claude-sonnet-5-5",
    "openai-codex/gpt-6.1-sol",
    "baseten/deepseek-v4-1-flash",
    "openai-codex/gpt-6-luna",
    "google/gemini-4-argon",
    "openai/openai/gpt-6-astra"
  ],
  "showCacheMissNotices": true,
  "collapseChangelog": true,
  "compaction": {
    "enabled": true
  },
  "steeringMode": "all"
}
