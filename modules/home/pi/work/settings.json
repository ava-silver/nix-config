{
  "npmCommand": [
    "bun"
  ],
  "warnings": {
    "anthropicExtraUsage": false
  },
  "lastChangelogVersion": "1.6.0",
  "theme": "catppuccin-frappe",
  "defaultThinkingLevel": "high",
  "quietStartup": true,
  "defaultTools": [
    "+grep",
    "+find"
  ],
  "hideThinkingBlock": true,
  "packages": [
    "npm:pi-btw",
    "npm:pi-session-auto-rename",
    "~/go/src/github.com/DataDog/datadog-pi-packages/packages/dd-ai-gateway"
  ],
  "extensions": [
    "-extensions/phone-notify.ts",
    "-extensions/read-aloud/index.ts",
    "-extensions/workflows/index.ts",
    "-extensions/ui-performance.ts"
  ],
  "skills": [
    "~/dd/claude-marketplace/serverless/skills",
    "~/dd/experimental/users/ava.silver/ssi/skills/"
  ],
  "defaultProvider": "anthropic",
  "defaultModel": "claude-opus-5-5",
  "enabledModels": [
    "anthropic/claude-opus-5-5",
    "anthropic/claude-sonnet-5-5",
    "baseten/deepseek-v4-1-flash",
    "openai-codex/gpt-6-luna",
    "openai-codex/gpt-6-astra",
    "google/gemini-4-neon",
    "google/gemini-4-carbon",
    "openai-codex/gpt-6.1-sol"
  ],
  "showCacheMissNotices": true,
  "collapseChangelog": true,
  "compaction": {
    "enabled": true
  },
  "steeringMode": "all",
  "extensionChangelogVersions": {
    "{\"source\":\"npm:pi-subagents\",\"scope\":\"project\"}": "0.89.0",
    "{\"source\":\"npm:pi-web-access\",\"scope\":\"project\"}": "0.48.0",
    "{\"source\":\"npm:visual-explainer\",\"scope\":\"project\"}": "0.15.0",
    "{\"source\":\"npm:pi-messenger\",\"scope\":\"project\"}": "0.15.2",
    "{\"source\":\"npm:pi-powerline-footer\",\"scope\":\"project\"}": "0.22.0"
  }
}
