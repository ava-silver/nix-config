{
  "npmCommand": [
    "bun"
  ],
  "warnings": {
    "anthropicExtraUsage": false
  },
  "lastChangelogVersion": "1.5.2",
  "theme": "catppuccin-frappe",
  "defaultThinkingLevel": "medium",
  "quietStartup": true,
  "defaultTools": [
    "+grep",
    "+find"
  ],
  "hideThinkingBlock": false,
  "packages": [
    "npm:pi-btw",
    "npm:pi-session-auto-rename",
    "~/repos/pi-spotify-provider"
  ],
  "extensions": [
    "-extensions/phone-notify.ts",
    "-extensions/slack-mcp/index.ts",
    "-extensions/read-aloud/index.ts",
    "-extensions/session-secret-redaction/index.ts",
    "-extensions/ui-performance.ts",
    "-extensions/spend.ts"
  ],
  "defaultProvider": "spotify",
  "defaultModel": "spotify/claude-sonnet-5-5",
  "enabledModels": [
    "spotify/claude-sonnet-5-5"
  ]
}
