[
  {
    "context": "Workspace",
    "bindings": {}
  },
  {
    "context": "os == linux && Workspace",
    "bindings": {
      "ctrl-r": "workspace::ToggleRightDock"
    },
    "unbind": {
      "ctrl-r": "projects::OpenRecent"
    }
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {}
  },
  {
    "context": "os == macos && Editor",
    "unbind": {
      "cmd-k p": "workspace::CopyPath"
    }
  },
  {
    "context": "os == macos && Workspace",
    "bindings": {
      "ctrl-alt-cmd-c": "workspace::CopyRelativePath"
    }
  },
  {
    "context": "os == macos && Terminal",
    "bindings": {
      "cmd-z": ["terminal::SendText", "\u001bZ"]
    }
  },
  {
    "context": "os == linux && Terminal",
    "bindings": {
      "ctrl-shift-z": ["terminal::SendText", "\u001bZ"]
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "alt-shift-f": "editor::Format",
      "ctrl-l g": "editor::CopyPermalinkToLine"
    }
  },
  {
    "context": "os == macos && Editor",
    "unbind": {
      "cmd-shift-i": "editor::Format"
    }
  },
  {
    "context": "Editor && extension == md",
    "bindings": {
      "ctrl-p": "markdown::OpenPreview"
    }
  }
]
